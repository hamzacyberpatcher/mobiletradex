# Optional. Enables Google Places search for "Another city" and "Somewhere else" on /sell.
# Create a browser key at https://console.cloud.google.com/google/maps-apis, enable "Places API (New)",
# restrict it to your site's referrers, then copy this file to .env.local and restart `next dev`.
# Without it the listing page falls back to typing the place by hand.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
